# Docker Compose downloads SenseVoice at build time and Laya on first startup.
# Current Laya deployment requires x86_64 Linux containers and an NVIDIA GPU.
APP_PORT=3000
APP_BIND=0.0.0.0
# Optional HTTPS: set both paths to use a fixed self-signed PEM certificate.
# Example: certs/server.crt and certs/server.key (also valid inside Docker).
# Include your LAN IP and 127.0.0.1 in the certificate's subjectAltName.
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
INFERENCE_THREADS=4
LOG_LEVEL=info
# Docker logs include tags, signal levels, timings and request IDs by default.
# Set true to also retain recognized text in the local Docker logs.
LOG_TRANSCRIPTS=false

# Local development only (Docker Compose sets its internal URL automatically).
SENSEVOICE_URL=http://127.0.0.1:50000

# Optional short reactions: local Laya decision model, no API key required.
# npm run dev / npm start load .env; existing process variables take precedence.
LAYA_MODEL=laya:322m-multilingual-mlx-fp16
LAYA_TIMEOUT_MS=5000
REACTION_CATALOG_PATH=config/reaction-phrases.csv
# Local development only; Compose always uses http://ollama:11434 internally.
# If this port changes, update OLLAMA_BASE_URL to match.
OLLAMA_DEV_PORT=11435
OLLAMA_BASE_URL=http://127.0.0.1:11435
