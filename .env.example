# Docker Compose: existing local SenseVoice source and downloaded model weights.
SENSEVOICE_SOURCE=/home/zxc/workspace3/code/SenseVoice
SENSEVOICE_MODEL_PATH=/home/zxc/.cache/modelscope/models/iic--SenseVoiceSmall/snapshots/master
APP_PORT=3000
APP_BIND=0.0.0.0
INFERENCE_THREADS=4
LOG_LEVEL=info
# Docker logs include tags, signal levels, timings and request IDs by default.
# Set true to also retain recognized text in the local Docker logs.
LOG_TRANSCRIPTS=false

# Local development only (Docker Compose sets its internal URL automatically).
SENSEVOICE_URL=http://127.0.0.1:50000

# Optional short reactions: local Laya decision model, no API key required.
# npm run dev / npm start load .env; existing process variables take precedence.
LAYA_MODEL=laya:322m-multilingual-mlx-fp16
LAYA_TIMEOUT_MS=5000
REACTION_CATALOG_PATH=config/reaction-phrases.csv
# Host development and Docker use different addresses for the existing Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
