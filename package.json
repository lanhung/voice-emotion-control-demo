{
  "name": "aura-voice-emotion-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "npm run typecheck && vite build && tsup server/index.ts --format esm --out-dir dist/server --platform node --target node22 --no-splitting",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.worklet.json",
    "test": "vitest run",
    "check:reactions": "tsx scripts/check-reaction-catalog.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "csv-parse": "7.0.3",
    "fastify": "^5.12.7",
    "lucide-react": "^0.577.0",
    "ollama": "0.6.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.183.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.18"
  }
}
