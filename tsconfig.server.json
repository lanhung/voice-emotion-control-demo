{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true,
    "esModuleInterop": true, "noEmit": true, "types": ["node"]
  },
  "include": ["server", "shared", "tests", "scripts", "playwright.config.ts"]
}
